# ============================================================
#  .gitignore — Fullstack Django + Angular
# ============================================================


# ──────────────────────────────────────────
#  PYTHON / DJANGO
# ──────────────────────────────────────────

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
.venv/
venv/
env/
ENV/
.env/

# Environment variables
.env
.env.*
!.env.example

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/

# Static files collected by collectstatic
staticfiles/
static_root/

# Migrations (opcional — descomenta si no quieres versionar migraciones)
# */migrations/*.py
# !*/migrations/__init__.py

# Pytest / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json

# Celery
celerybeat-schedule
celerybeat.pid

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
MANIFEST

# Jupyter Notebooks
.ipynb_checkpoints/

# pyenv
.python-version


# ──────────────────────────────────────────
#  NODE / ANGULAR
# ──────────────────────────────────────────

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Angular build output
dist/
tmp/
out-tsc/
bazel-out/

# Angular cache
.angular/

# Environment files (Angular)
src/environments/environment.prod.ts
# Mantén el archivo base como plantilla:
# !src/environments/environment.ts

# Testing
coverage/
.nyc_output/

# Protractor
e2e/*.js
e2e/*.map

# Package lock (elige solo uno según tu gestor)
# package-lock.json   # descomenta si usas yarn/pnpm
# yarn.lock           # descomenta si usas npm/pnpm

# System files de npm
.npm/


# ──────────────────────────────────────────
#  IDEs y EDITORES
# ──────────────────────────────────────────

# VSCode
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example

# JetBrains (PyCharm, WebStorm, etc.)
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Emacs
*.swp
*.swo
*~
\#*\#
.DS_Store


# ──────────────────────────────────────────
#  SISTEMAS OPERATIVOS
# ──────────────────────────────────────────

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~


# ──────────────────────────────────────────
#  DOCKER
# ──────────────────────────────────────────

# Nunca versiones secretos de Docker
docker-compose.override.yml
.dockerenv


# ──────────────────────────────────────────
#  CERTIFICADOS Y SECRETOS
# ──────────────────────────────────────────

*.pem
*.key
*.cert
*.crt
secrets/
.secrets/


# ──────────────────────────────────────────
#  MISC
# ──────────────────────────────────────────

# Archivos de respaldo
*.bak
*.backup
*.orig
*.tmp

# Logs genéricos
logs/
*.log